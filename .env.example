# Copy to .env (git-ignored) and fill in.
# One or more alert recipients, comma-separated
EMAIL=you@example.com
# AWS_PROFILE=default
# AWS_REGION=us-west-2
# Optional custom domain for the dashboard (needs an ACM cert in us-east-1):
# DOMAIN=outbreak.example.com
# CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Random secret CloudFront sends to the sign-up API (generate one, keep it private)
ORIGIN_SECRET=
# Optional: monthly AWS cost alert in USD, emailed to the first EMAIL address
BUDGET_USD=10
# Optional: WAF web ACL ARN (us-east-1, CLOUDFRONT scope) to attach to the distribution
WEB_ACL_ARN=
